# Python caches
__pycache__/
*.pyc

# Per-user state
settings/preferences.json

# Real liveries and game data stay on this computer only. TSU writes the
# player's Steam ID into every export (exportId), so none of them are published.
samples/*
!samples/README.md

# Build outputs
build/
# The built apps, their checksums and any unpacked copy of one
releases/
turbohud/_build.py
# One's own layouts (customization/display_presets), made by the app when run from source
customization/

# Development tools environment (Ruff formatter, Rust, llvm-mingw); never shipped
.buildtools/

# The Rust reader's build output, if cargo is run without tools/get_rust.sh's settings
reader/target/

# Folder view settings the macOS Finder writes into every folder it shows
.DS_Store

# Logs and data from testers: personal (names, paths, times), never on GitHub
user_logs/

# Private notes: stay on this computer, never on GitHub (the repo will be public later)
docs/SUGGESTIONS.md
